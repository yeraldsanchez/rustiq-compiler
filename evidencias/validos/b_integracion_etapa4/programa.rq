fn duplicar(r: &i32) -> i32 {
    *r * 2
}

fn main() {
    let x: i32;
    x = 21;
    let r = &x;
    let rr = &r;
    print_i32(duplicar(*rr));

    {
        let x = "sombreado";
        print_str(x);
    }

    let par = (10, 20);
    let suma = match par {
        (a, b) => a + b,
    };
    print_i32(suma);
}
