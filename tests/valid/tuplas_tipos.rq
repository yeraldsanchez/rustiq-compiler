// Tuplas (desestructuradas con match), f64, char, bool y patrón de tupla.
fn suma_par(p: (i32, i32)) -> i32 {
    match p {
        (a, b) => a + b,
    }
}

fn intercambiar(p: (i32, i32)) -> (i32, i32) {
    match p {
        (a, b) => (b, a),
    }
}

fn promedio(a: f64, b: f64) -> f64 {
    (a + b) / 2.0
}

fn main() {
    let par: (i32, i32) = (3, 8);
    print_i32(suma_par(par));

    let inv = intercambiar((3, 8));
    print_i32(suma_par(inv));

    print_f64(promedio(2.5, 4.0));

    let letra: char = 'R';
    print_char(letra);

    let mayor: bool = 3.5 > 1.25;
    print_bool(mayor);

    let r: i32 = match (suma_par(inv), mayor) {
        (11, true) => 1,
        (_, false) => 2,
        _ => 3,
    };
    print_i32(r);
}
