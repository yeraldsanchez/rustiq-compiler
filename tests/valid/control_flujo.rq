// Control de flujo: if/else if/else, while, loop, break y continue.
// `if` es solo sentencia (P4): para devolver un valor se usa return.
fn clasificar(n: i32) -> i32 {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    }
    1
}

fn main() {
    // while con continue: suma solo los impares del 1 al 9
    let mut i: i32 = 0;
    let mut impares: i32 = 0;
    while i < 10 {
        i += 1;
        if i % 2 == 0 {
            continue;
        }
        impares += i;
    }
    print_i32(impares);

    // loop con break: primer múltiplo de 7 mayor que 30
    let mut k: i32 = 30;
    loop {
        k += 1;
        if k % 7 == 0 {
            break;
        }
    }
    print_i32(k);

    print_i32(clasificar(-8));
    print_i32(clasificar(0));
    print_i32(clasificar(42));
}
